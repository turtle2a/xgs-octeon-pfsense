xgs_octep_load="YES"
hw.xgs_octep.autostart="1"
hw.xgs_octep.ifaces="1"
hw.xgs_octep.tx="1"
hw.clflush_disable="1"
legal.intel_ipw.license_ack="1"
legal.intel_iwi.license_ack="1"
debug.kassert.warn_only="1"
hw.ixl.enable_head_writeback="0"
hw.syscons.kbd_reboot="0"
hw.vtnet.csum_disable="1"
kern.coredump="0"
security.bsd.see_other_gids="0"
security.bsd.see_other_uids="0"
vm.numa.disabled="1"
kern.cam.boot_delay=10000
kern.geom.label.disk_ident.enable="0"
kern.geom.label.gptid.enable="0"
kern.ipc.nmbclusters="1000000"
kern.ipc.nmbjumbo9="524288"
kern.ipc.nmbjumbop="524288"
opensolaris_load="YES"
zfs_load="YES"
cryptodev_load="YES"
loader_conf_files="/boot/loader.conf.lua"
boot_multicons="NO"
boot_serial="YES"
console="comconsole"
comconsole_speed="115200"
autoboot_delay="10"
hw.hn.vf_transparent="0"
hw.hn.use_if_start="1"
hw.vtnet.altq_disable="0"
net.link.ifqmaxlen="128"
machdep.hwpstate_pkg_ctrl="1"
